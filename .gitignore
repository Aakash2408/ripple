__pycache__/
*.pyc
.env
.venv/
venv/
dist/
*.egg-info/
.DS_Store

# Credentials -- must never be committed. The GitHub App private key can
# mint installation tokens for every repo the App is installed on.
*.pem
*.key
*private-key*
data/tokens.json
data/activity.json
data/*.json
# Runtime SQLite stores. data/*.json already covered the JSON stores, so
# poll_state.db was the one piece of runtime state `git add .` would have
# committed. The -wal and -shm sidecars exist because poll_store.py opens the
# database in WAL mode, and they appear and vanish around a live connection.
data/*.db
data/*.db-wal
data/*.db-shm
tests/.last_run.json
tools/.durability_check.json
tests/.e2e_evidence.json
