#!/usr/bin/env bash
# ripple -- run the Ripple CLI from a checkout, with any Python >= 3.10.
#
# The local `impact` command needs only the standard library. Contract diffing
# (OpenAPI/proto/GraphQL/...) also needs PyYAML; without it those specs are
# reported as "could not diff", never silently skipped.
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    LINK="$(readlink "$SELF")"
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *)  SELF="$(dirname "$SELF")/$LINK" ;;
    esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

PY=""
for c in python3.13 python3.12 python3.11 python3.10 python3; do
    if command -v "$c" >/dev/null 2>&1 && \
       "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' \
           2>/dev/null; then
        PY="$c"
        break
    fi
done
if [ -z "$PY" ]; then
    echo "ripple: needs Python >= 3.10 on PATH" >&2
    exit 2
fi

PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m app.cli "$@"
